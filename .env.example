# Server Configuration
PORT=5080
MONGO_URI=mongodb://localhost:27017/portfolioDB
CLIENT_URI=http://localhost:5082
SERVER_URI=http://localhost:5080

# CORS ORIGIN
CORS_ORIGINS=http://localhost:5082

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Single-owner gate: the Clerk user id (clerk_xxx) allowed into the dashboard API
ADMIN_CLERK_ID=clerk_xxx

# SMTP (contact form notifications to the owner inbox)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
CONTACT_NOTIFY_EMAIL=owner@example.com
